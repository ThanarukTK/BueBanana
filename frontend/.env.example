# Server-side only. Never prefix these with NEXT_PUBLIC_.
#
# Local Backend (run `bun src/server.ts` in backend/) — use this while testing with your own data.
API_BASE_URL=http://localhost:3000
# Deployed Backend instead of the local one:
# API_BASE_URL=https://buebanana.onrender.com

# --- Staff sign-in (test phase) ---------------------------------------------------------------
# The Backend has no staff-account API yet, so the console verifies these credentials itself
# (lib/staff-auth.ts) and issues a signed 30-day session cookie. One account:
#
#   STAFF_ROLE is `admin` or `staff` (staff cannot open /admin/staff)
STAFF_USERNAME=admin
STAFF_PASSWORD=1234
STAFF_DISPLAY_NAME=Admin
STAFF_ROLE=admin
# Several accounts at once — username:password:role:display, separated by ';':
# STAFF_ACCOUNTS=admin:change-me-12-chars:admin:Admin;frontdesk:change-me-12-chars:staff:Front desk

# The Backend's shared staff token (backend/.env → STAFF_API_TOKEN). Sent server-side only.
STAFF_API_TOKEN=dev-staff-token
STAFF_ID=staff-dev-1

# Signs the session cookie (at least 16 characters). Generate with: openssl rand -hex 32
# Keep it stable: changing it signs every staff member out.
SESSION_SECRET=change-me-output-of-openssl-rand-hex-32
