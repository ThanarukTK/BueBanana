# Backend environment — copy to `backend/.env` (gitignored) and fill in.
# Never commit a real connection string, password, or service_role key (AGENTS.md §5).

# Which repository the API uses: memory (default, no database) | postgres (Supabase/PostgreSQL)
STORE=memory

# Supabase → Connect → "Shared pooler, session mode" (port 5432).
# Do NOT use the "Direct connection" string: it is IPv6-only on Free plans and fails from an
# IPv4-only network. See docs/supabase-migration-plan.md.
# Leave the dashboard's own [YOUR-PASSWORD] token in place and put the password on the line below —
# it is percent-encoded for you, so characters like @ : / ? # & are safe.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=


# Pepper for HMAC-SHA256 hashing of raw NFC UIDs (PDPA: a bare hash of a low-entropy UID is
# brute-forceable). Generate one, e.g.  openssl rand -hex 32
# Required when STORE=postgres; the server refuses to start on the development default.
TAG_UID_PEPPER=

# Development credentials (docs/backend-mvp.md). Replace in any real deployment.
DEVICE_API_KEY=dev-device-key
STAFF_API_TOKEN=dev-staff-token
DEV_STAFF_ID=staff-dev-1
PORT=3000
